rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function ownsPath(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasExactly(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function isBoundedString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isValidIdentifier(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 128
        && value.matches('^[A-Za-z0-9_-]+$');
    }

    function isValidLogicalDay(value) {
      return value is string
        && value.size() == 10
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidSlot(value) {
      return value == 'afternoon' || value == 'night';
    }

    function isValidSource(value) {
      return value == 'app'
        || value == 'app_preview'
        || value == 'widget_2x2'
        || value == 'widget_4x2';
    }

    function isValidTheme(value) {
      return value == 'system' || value == 'light' || value == 'dark';
    }

    function isServerTimestamp(value) {
      return value is timestamp && value == request.time;
    }

    function validUserDocument(userId, data) {
      return hasExactly(
          data,
          ['ownerUid', 'createdAt', 'updatedAt', 'schemaVersion']
        )
        && data.ownerUid is string
        && data.ownerUid == userId
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.schemaVersion is int
        && data.schemaVersion == 1;
    }

    function validSettingsDocument(userId, data) {
      return hasExactly(
          data,
          [
            'ownerUid',
            'resetMinutesAfterMidnight',
            'timezoneId',
            'displayName',
            'themePreference',
            'updatedAt',
            'schemaVersion'
          ]
        )
        && data.ownerUid is string
        && data.ownerUid == userId
        && data.resetMinutesAfterMidnight is int
        && data.resetMinutesAfterMidnight >= 0
        && data.resetMinutesAfterMidnight <= 1439
        && isBoundedString(data.timezoneId, 100)
        && isBoundedString(data.displayName, 80)
        && isValidTheme(data.themePreference)
        && data.updatedAt is timestamp
        && data.schemaVersion is int
        && data.schemaVersion == 1;
    }

    function validMedicineDocument(userId, medicineId, data) {
      let commonValid = isValidIdentifier(data.id)
        && data.id == medicineId
        && data.ownerUid is string
        && data.ownerUid == userId
        && isBoundedString(data.name, 100)
        && data.afternoonEnabled is bool
        && isBoundedString(data.afternoonLabel, 60)
        && data.nightEnabled is bool
        && isBoundedString(data.nightLabel, 60)
        && (data.afternoonEnabled || data.nightEnabled)
        && data.archived is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.schemaVersion is int;
      let validV1 = hasExactly(
          data,
          [
            'id',
            'ownerUid',
            'name',
            'afternoonEnabled',
            'afternoonLabel',
            'nightEnabled',
            'nightLabel',
            'archived',
            'createdAt',
            'updatedAt',
            'schemaVersion'
          ]
        )
        && data.schemaVersion == 1;
      let validV2 = hasExactly(
          data,
          [
            'id',
            'ownerUid',
            'name',
            'afternoonEnabled',
            'afternoonLabel',
            'afternoonCountdownMinutes',
            'nightEnabled',
            'nightLabel',
            'nightCountdownMinutes',
            'archived',
            'createdAt',
            'updatedAt',
            'schemaVersion'
          ]
        )
        && data.schemaVersion == 2
        && (
          data.afternoonCountdownMinutes == null
          || (
            data.afternoonEnabled
            && data.afternoonCountdownMinutes is int
            && data.afternoonCountdownMinutes >= 1
            && data.afternoonCountdownMinutes <= 1440
          )
        )
        && (
          data.nightCountdownMinutes == null
          || (
            data.nightEnabled
            && data.nightCountdownMinutes is int
            && data.nightCountdownMinutes >= 1
            && data.nightCountdownMinutes <= 1440
          )
        );
      return commonValid && (validV1 || validV2);
    }

    function validCountdownStateDocument(userId, countdownStateId, data) {
      return hasExactly(
          data,
          [
            'ownerUid',
            'logicalDay',
            'medicineId',
            'slot',
            'durationMinutes',
            'startedAt',
            'targetAt',
            'startedTimezone',
            'startedSource',
            'status',
            'cancelledAt',
            'completedAt',
            'updatedAt',
            'lastActionId',
            'schemaVersion'
          ]
        )
        && data.ownerUid == userId
        && isValidLogicalDay(data.logicalDay)
        && isValidIdentifier(data.medicineId)
        && isValidSlot(data.slot)
        && countdownStateId == data.logicalDay + '_' + data.medicineId + '_' + data.slot
        && data.durationMinutes is int
        && data.durationMinutes >= 1
        && data.durationMinutes <= 1440
        && data.startedAt is timestamp
        && data.targetAt is timestamp
        && data.targetAt
          == data.startedAt + duration.value(data.durationMinutes, 'm')
        && isBoundedString(data.startedTimezone, 100)
        && isValidSource(data.startedSource)
        && (
          data.status == 'running'
          || data.status == 'cancelled'
          || data.status == 'consumed'
        )
        && (data.cancelledAt == null || data.cancelledAt is timestamp)
        && (data.completedAt == null || data.completedAt is timestamp)
        && data.updatedAt is timestamp
        && isValidIdentifier(data.lastActionId)
        && data.schemaVersion == 1;
    }

    function validCountdownEventDocument(userId, eventId, data) {
      return hasExactly(
          data,
          [
            'eventId',
            'ownerUid',
            'action',
            'logicalDay',
            'medicineId',
            'slot',
            'durationMinutes',
            'occurredAt',
            'timezoneId',
            'source',
            'relatedStateId',
            'previousActionId',
            'syncedAt',
            'schemaVersion'
          ]
        )
        && isValidIdentifier(data.eventId)
        && data.eventId == eventId
        && data.ownerUid == userId
        && (
          data.action == 'start'
          || data.action == 'cancel'
          || data.action == 'restart'
          || data.action == 'clear_by_check'
        )
        && isValidLogicalDay(data.logicalDay)
        && isValidIdentifier(data.medicineId)
        && isValidSlot(data.slot)
        && data.durationMinutes is int
        && data.durationMinutes >= 1
        && data.durationMinutes <= 1440
        && data.occurredAt is timestamp
        && isBoundedString(data.timezoneId, 100)
        && isValidSource(data.source)
        && (
          data.action == 'start'
          || data.action == 'clear_by_check'
          || data.source == 'app'
        )
        && data.relatedStateId == data.logicalDay + '_' + data.medicineId + '_' + data.slot
        && (
          data.previousActionId == null
          || isValidIdentifier(data.previousActionId)
        )
        && isServerTimestamp(data.syncedAt)
        && data.schemaVersion == 1;
    }

    function countdownEventAfterMatchesState(userId, stateId, state) {
      let event = getAfter(
        /databases/$(database)/documents/users/$(userId)/countdownEvents/$(state.lastActionId)
      ).data;
      let statePath =
        /databases/$(database)/documents/users/$(userId)/countdownStates/$(stateId);
      let previousActionId = exists(statePath) ? get(statePath).data.lastActionId : null;
      return event.ownerUid == userId
        && event.relatedStateId == stateId
        && event.logicalDay == state.logicalDay
        && event.medicineId == state.medicineId
        && event.slot == state.slot
        && event.durationMinutes == state.durationMinutes
        && (
          (
            event.action == 'start'
            && (
              (previousActionId == null && event.previousActionId == null)
              || event.previousActionId == previousActionId
            )
          )
          || (event.action != 'start' && event.previousActionId == previousActionId)
        )
        && (
          (
            (event.action == 'start' || event.action == 'restart')
            && state.status == 'running'
            && state.cancelledAt == null
            && state.completedAt == null
            && state.startedAt == event.occurredAt
            && state.startedTimezone == event.timezoneId
            && state.startedSource == event.source
          )
          || (
            event.action == 'cancel'
            && state.status == 'cancelled'
            && state.cancelledAt == event.occurredAt
            && state.completedAt == null
          )
          || (
            event.action == 'clear_by_check'
            && state.status == 'consumed'
            && state.completedAt == event.occurredAt
            && state.cancelledAt == null
          )
        );
    }

    function countdownStateAfterMatchesEvent(userId, eventId, event) {
      let state = getAfter(
        /databases/$(database)/documents/users/$(userId)/countdownStates/$(event.relatedStateId)
      ).data;
      return state.lastActionId == eventId
        && countdownEventAfterMatchesState(userId, event.relatedStateId, state);
    }

    function validCountdownStateTransition(oldState, newState) {
      return newState.ownerUid == oldState.ownerUid
        && newState.logicalDay == oldState.logicalDay
        && newState.medicineId == oldState.medicineId
        && newState.slot == oldState.slot
        && newState.lastActionId != oldState.lastActionId
        && (
          (
            (oldState.status == 'cancelled' || oldState.status == 'consumed')
            && newState.status == 'running'
            && newState.cancelledAt == null
            && newState.completedAt == null
            && newState.diff(oldState).affectedKeys().hasOnly(
              [
                'status',
                'durationMinutes',
                'startedAt',
                'targetAt',
                'startedTimezone',
                'startedSource',
                'cancelledAt',
                'completedAt',
                'lastActionId',
                'updatedAt'
              ]
            )
          )
          || (
            oldState.status == 'running'
            && newState.status == 'running'
            && newState.diff(oldState).affectedKeys().hasOnly(
              [
                'durationMinutes',
                'startedAt',
                'targetAt',
                'startedTimezone',
                'startedSource',
                'lastActionId',
                'updatedAt'
              ]
            )
          )
          || (
            oldState.status == 'running'
            && newState.status == 'cancelled'
            && newState.diff(oldState).affectedKeys().hasOnly(
              ['status', 'cancelledAt', 'lastActionId', 'updatedAt']
            )
          )
          || (
            oldState.status == 'running'
            && newState.status == 'consumed'
            && newState.diff(oldState).affectedKeys().hasOnly(
              ['status', 'completedAt', 'lastActionId', 'updatedAt']
            )
          )
        );
    }

    function validDoseStateDocument(userId, doseStateId, data) {
      return hasExactly(
          data,
          [
            'ownerUid',
            'logicalDay',
            'medicineId',
            'slot',
            'labelSnapshot',
            'medicineNameSnapshot',
            'isTaken',
            'checkedAt',
            'checkedTimezone',
            'checkedSource',
            'undoneAt',
            'lastActionId',
            'updatedAt',
            'schemaVersion'
          ]
        )
        && data.ownerUid is string
        && data.ownerUid == userId
        && isValidLogicalDay(data.logicalDay)
        && isValidIdentifier(data.medicineId)
        && isValidSlot(data.slot)
        && doseStateId == data.logicalDay + '_' + data.medicineId + '_' + data.slot
        && isBoundedString(data.labelSnapshot, 60)
        && isBoundedString(data.medicineNameSnapshot, 100)
        && data.isTaken is bool
        && data.checkedAt is timestamp
        && isBoundedString(data.checkedTimezone, 100)
        && isValidSource(data.checkedSource)
        && (data.undoneAt == null || data.undoneAt is timestamp)
        && isValidIdentifier(data.lastActionId)
        && data.updatedAt is timestamp
        && data.schemaVersion is int
        && data.schemaVersion == 1;
    }

    function validDoseEventDocument(userId, eventId, data) {
      return hasExactly(
          data,
          [
            'eventId',
            'ownerUid',
            'action',
            'logicalDay',
            'medicineId',
            'medicineNameSnapshot',
            'slot',
            'labelSnapshot',
            'occurredAt',
            'timezoneId',
            'source',
            'relatedStateId',
            'previousActionId',
            'syncedAt',
            'schemaVersion'
          ]
        )
        && isValidIdentifier(data.eventId)
        && data.eventId == eventId
        && data.ownerUid is string
        && data.ownerUid == userId
        && (data.action == 'check' || data.action == 'undo')
        && isValidLogicalDay(data.logicalDay)
        && isValidIdentifier(data.medicineId)
        && isBoundedString(data.medicineNameSnapshot, 100)
        && isValidSlot(data.slot)
        && isBoundedString(data.labelSnapshot, 60)
        && data.occurredAt is timestamp
        && isBoundedString(data.timezoneId, 100)
        && isValidSource(data.source)
        && (
          (data.action == 'check')
          || (data.action == 'undo' && data.source == 'app')
        )
        && data.relatedStateId
          == data.logicalDay + '_' + data.medicineId + '_' + data.slot
        && (
          (
            data.action == 'check'
            && data.previousActionId == null
          )
          || (
            data.action == 'undo'
            && isValidIdentifier(data.previousActionId)
          )
        )
        && isServerTimestamp(data.syncedAt)
        && data.schemaVersion is int
        && data.schemaVersion == 1;
    }

    function eventAfterMatchesState(userId, doseStateId, state) {
      let event = getAfter(
        /databases/$(database)/documents/users/$(userId)/doseEvents/$(state.lastActionId)
      ).data;
      let statePath =
        /databases/$(database)/documents/users/$(userId)/doseStates/$(doseStateId);
      let previousActionId =
        exists(statePath) ? get(statePath).data.lastActionId : null;
      return event.ownerUid == userId
        && event.eventId == state.lastActionId
        && event.logicalDay == state.logicalDay
        && event.medicineId == state.medicineId
        && event.medicineNameSnapshot == state.medicineNameSnapshot
        && event.slot == state.slot
        && event.labelSnapshot == state.labelSnapshot
        && event.relatedStateId == doseStateId
        && (
          (
            event.action == 'check'
            && event.previousActionId == null
          )
          || (
            event.action == 'undo'
            && event.previousActionId == previousActionId
          )
        )
        && (
          (
            state.isTaken == true
            && state.undoneAt == null
            && event.action == 'check'
            && event.occurredAt == state.checkedAt
            && event.timezoneId == state.checkedTimezone
            && event.source == state.checkedSource
          )
          || (
            state.isTaken == false
            && state.undoneAt is timestamp
            && event.action == 'undo'
            && event.occurredAt == state.undoneAt
            && event.source == 'app'
          )
        );
    }

    function stateAfterMatchesEvent(userId, eventId, event) {
      let state = getAfter(
        /databases/$(database)/documents/users/$(userId)/doseStates/$(event.relatedStateId)
      ).data;
      let statePath =
        /databases/$(database)/documents/users/$(userId)/doseStates/$(event.relatedStateId);
      let previousActionId =
        exists(statePath) ? get(statePath).data.lastActionId : null;
      return state.ownerUid == userId
        && state.lastActionId == eventId
        && state.logicalDay == event.logicalDay
        && state.medicineId == event.medicineId
        && state.medicineNameSnapshot == event.medicineNameSnapshot
        && state.slot == event.slot
        && state.labelSnapshot == event.labelSnapshot
        && (
          (
            event.action == 'check'
            && event.previousActionId == null
          )
          || (
            event.action == 'undo'
            && event.previousActionId == previousActionId
          )
        )
        && (
          (
            event.action == 'check'
            && state.isTaken == true
            && state.undoneAt == null
            && state.checkedAt == event.occurredAt
            && state.checkedTimezone == event.timezoneId
            && state.checkedSource == event.source
          )
          || (
            event.action == 'undo'
            && event.source == 'app'
            && state.isTaken == false
            && state.undoneAt == event.occurredAt
          )
        );
    }

    function validDoseStateTransition(oldState, newState) {
      return newState.lastActionId != oldState.lastActionId
        && (
          (
            oldState.isTaken == true
            && newState.isTaken == false
            && newState.undoneAt is timestamp
            && newState.diff(oldState).affectedKeys().hasOnly(
              ['isTaken', 'undoneAt', 'lastActionId', 'updatedAt']
            )
          )
          || (
            oldState.isTaken == false
            && newState.isTaken == true
            && newState.undoneAt == null
            && newState.diff(oldState).affectedKeys().hasOnly(
              [
                'medicineNameSnapshot',
                'labelSnapshot',
                'isTaken',
                'checkedAt',
                'checkedTimezone',
                'checkedSource',
                'undoneAt',
                'lastActionId',
                'updatedAt'
              ]
            )
          )
        );
    }

    match /users/{userId} {
      // A root user document is addressable only by that user. Listing the
      // users collection is intentionally not allowed.
      allow get: if ownsPath(userId);
      allow create: if ownsPath(userId)
        && validUserDocument(userId, request.resource.data)
        && isServerTimestamp(request.resource.data.createdAt)
        && isServerTimestamp(request.resource.data.updatedAt);
      allow update: if ownsPath(userId)
        && validUserDocument(userId, request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && isServerTimestamp(request.resource.data.updatedAt);
      allow delete: if ownsPath(userId);

      match /settings/{settingsId} {
        allow get, list: if ownsPath(userId);
        allow create: if ownsPath(userId)
          && settingsId == 'preferences'
          && validSettingsDocument(userId, request.resource.data)
          && isServerTimestamp(request.resource.data.updatedAt);
        allow update: if ownsPath(userId)
          && settingsId == 'preferences'
          && validSettingsDocument(userId, request.resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && isServerTimestamp(request.resource.data.updatedAt);
        allow delete: if ownsPath(userId);
      }

      match /medicines/{medicineId} {
        allow get, list: if ownsPath(userId);
        allow create: if ownsPath(userId)
          && validMedicineDocument(userId, medicineId, request.resource.data)
          && isServerTimestamp(request.resource.data.createdAt)
          && isServerTimestamp(request.resource.data.updatedAt);
        allow update: if ownsPath(userId)
          && validMedicineDocument(userId, medicineId, request.resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && isServerTimestamp(request.resource.data.updatedAt);
        allow delete: if ownsPath(userId);
      }

      match /doseStates/{doseStateId} {
        allow get, list: if ownsPath(userId);
        allow create: if ownsPath(userId)
          && validDoseStateDocument(
            userId,
            doseStateId,
            request.resource.data
          )
          && request.resource.data.isTaken == true
          && request.resource.data.undoneAt == null
          && isServerTimestamp(request.resource.data.updatedAt)
          && eventAfterMatchesState(
            userId,
            doseStateId,
            request.resource.data
          );
        allow update: if ownsPath(userId)
          && validDoseStateDocument(
            userId,
            doseStateId,
            request.resource.data
          )
          && validDoseStateTransition(resource.data, request.resource.data)
          && isServerTimestamp(request.resource.data.updatedAt)
          && eventAfterMatchesState(
            userId,
            doseStateId,
            request.resource.data
          );
        allow delete: if ownsPath(userId);
      }

      match /doseEvents/{eventId} {
        allow get, list: if ownsPath(userId);
        allow create: if ownsPath(userId)
          && validDoseEventDocument(userId, eventId, request.resource.data)
          && stateAfterMatchesEvent(userId, eventId, request.resource.data);
        // Audit events are immutable. Owner-only deletion remains available
        // for the documented client-side account deletion flow.
        allow update: if false;
        allow delete: if ownsPath(userId);
      }

      match /countdownStates/{countdownStateId} {
        allow get, list: if ownsPath(userId);
        allow create: if ownsPath(userId)
          && validCountdownStateDocument(userId, countdownStateId, request.resource.data)
          && request.resource.data.status == 'running'
          && request.resource.data.cancelledAt == null
          && request.resource.data.completedAt == null
          && isServerTimestamp(request.resource.data.updatedAt)
          && countdownEventAfterMatchesState(
            userId,
            countdownStateId,
            request.resource.data
          );
        allow update: if ownsPath(userId)
          && validCountdownStateDocument(userId, countdownStateId, request.resource.data)
          && validCountdownStateTransition(resource.data, request.resource.data)
          && isServerTimestamp(request.resource.data.updatedAt)
          && countdownEventAfterMatchesState(
            userId,
            countdownStateId,
            request.resource.data
          );
        allow delete: if ownsPath(userId);
      }

      match /countdownEvents/{eventId} {
        allow get, list: if ownsPath(userId);
        allow create: if ownsPath(userId)
          && validCountdownEventDocument(userId, eventId, request.resource.data)
          && countdownStateAfterMatchesEvent(userId, eventId, request.resource.data);
        allow update: if false;
        allow delete: if ownsPath(userId);
      }
    }

    // Unknown top-level collections, nested collections, and collection-group
    // queries have no matching allow rule.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
