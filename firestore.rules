rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function ownsPath(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasExactly(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function isBoundedString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isOptionalString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isValidIdentifier(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 128
        && value.matches('^[A-Za-z0-9_-]+$');
    }

    function isValidLogicalDay(value) {
      return value is string
        && value.size() == 10
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isOptionalLogicalDay(value) {
      return value == null || isValidLogicalDay(value);
    }

    function isValidSlot(value) {
      return value == 'morning'
        || value == 'afternoon'
        || value == 'evening'
        || value == 'night';
    }

    function isLegacySlot(value) {
      return value == 'afternoon' || value == 'night';
    }

    function isValidSource(value) {
      return value == 'app'
        || value == 'app_preview'
        || value == 'widget_2x2'
        || value == 'widget_4x2'
        || value == 'widget_4x4'
        || value == 'notification';
    }

    function isLegacySource(value) {
      return value == 'app'
        || value == 'app_preview'
        || value == 'widget_2x2'
        || value == 'widget_4x2';
    }

    function isValidTheme(value) {
      return value == 'system' || value == 'light' || value == 'dark';
    }

    function isValidWidgetNameMode(value) {
      return value == 'full' || value == 'nickname' || value == 'hidden';
    }

    function isServerTimestamp(value) {
      return value is timestamp && value == request.time;
    }

    function isNullableCountdown(value, enabled) {
      return value == null
        || (
          enabled
          && value is int
          && value >= 1
          && value <= 1440
        );
    }

    function isNullableReminder(value, enabled) {
      return value == null
        || (
          enabled
          && value is int
          && value >= 0
          && value <= 1439
        );
    }

    function isPositiveNumber(value, maxValue) {
      return (value is int || value is float)
        && value > 0
        && value <= maxValue;
    }

    function isBoundedNumber(value, maxValue) {
      return (value is int || value is float)
        && value >= -maxValue
        && value <= maxValue;
    }

    function isNullableNonNegativeNumber(value, maxValue) {
      return value == null
        || (
          (value is int || value is float)
          && value >= 0
          && value <= maxValue
        );
    }

    function validUserDocument(userId, data) {
      return hasExactly(
          data,
          ['ownerUid', 'createdAt', 'updatedAt', 'schemaVersion']
        )
        && data.ownerUid == userId
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.schemaVersion == 1;
    }

    function validSettingsDocument(userId, data) {
      return hasExactly(
          data,
          [
            'ownerUid',
            'resetMinutesAfterMidnight',
            'timezoneId',
            'displayName',
            'themePreference',
            'updatedAt',
            'schemaVersion'
          ]
        )
        && data.ownerUid == userId
        && data.resetMinutesAfterMidnight is int
        && data.resetMinutesAfterMidnight >= 0
        && data.resetMinutesAfterMidnight <= 1439
        && isBoundedString(data.timezoneId, 100)
        && isBoundedString(data.displayName, 80)
        && isValidTheme(data.themePreference)
        && data.updatedAt is timestamp
        && data.schemaVersion == 1;
    }

    function validMedicineCommon(userId, medicineId, data) {
      return isValidIdentifier(data.id)
        && data.id == medicineId
        && data.ownerUid == userId
        && isBoundedString(data.name, 100)
        && data.afternoonEnabled is bool
        && isBoundedString(data.afternoonLabel, 60)
        && data.nightEnabled is bool
        && isBoundedString(data.nightLabel, 60)
        && data.archived is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.schemaVersion is int;
    }

    function validMedicineV1(userId, medicineId, data) {
      return validMedicineCommon(userId, medicineId, data)
        && hasExactly(
          data,
          [
            'id', 'ownerUid', 'name',
            'afternoonEnabled', 'afternoonLabel',
            'nightEnabled', 'nightLabel',
            'archived', 'createdAt', 'updatedAt', 'schemaVersion'
          ]
        )
        && data.schemaVersion == 1
        && (data.afternoonEnabled || data.nightEnabled);
    }

    function validMedicineV2(userId, medicineId, data) {
      return validMedicineCommon(userId, medicineId, data)
        && hasExactly(
          data,
          [
            'id', 'ownerUid', 'name',
            'afternoonEnabled', 'afternoonLabel', 'afternoonCountdownMinutes',
            'nightEnabled', 'nightLabel', 'nightCountdownMinutes',
            'archived', 'createdAt', 'updatedAt', 'schemaVersion'
          ]
        )
        && data.schemaVersion == 2
        && (data.afternoonEnabled || data.nightEnabled)
        && isNullableCountdown(data.afternoonCountdownMinutes, data.afternoonEnabled)
        && isNullableCountdown(data.nightCountdownMinutes, data.nightEnabled);
    }

    function validMedicineV3(userId, medicineId, data) {
      return validMedicineCommon(userId, medicineId, data)
        && hasExactly(
          data,
          [
            'id', 'ownerUid', 'name', 'nickname', 'notes', 'widgetNameMode',
            'morningEnabled', 'morningLabel', 'morningCountdownMinutes', 'morningReminderMinutes',
            'afternoonEnabled', 'afternoonLabel', 'afternoonCountdownMinutes', 'afternoonReminderMinutes',
            'eveningEnabled', 'eveningLabel', 'eveningCountdownMinutes', 'eveningReminderMinutes',
            'nightEnabled', 'nightLabel', 'nightCountdownMinutes', 'nightReminderMinutes',
            'startDate', 'endDate',
            'supplyEnabled', 'supplyInitialUnits', 'unitsPerDose', 'lowSupplyThreshold', 'supplyUnitName',
            'archived', 'createdAt', 'updatedAt', 'schemaVersion'
          ]
        )
        && data.schemaVersion == 3
        && isOptionalString(data.nickname, 60)
        && isOptionalString(data.notes, 500)
        && isValidWidgetNameMode(data.widgetNameMode)
        && (data.widgetNameMode != 'nickname' || isBoundedString(data.nickname, 60))
        && data.morningEnabled is bool
        && isBoundedString(data.morningLabel, 60)
        && data.eveningEnabled is bool
        && isBoundedString(data.eveningLabel, 60)
        && (
          data.morningEnabled
          || data.afternoonEnabled
          || data.eveningEnabled
          || data.nightEnabled
        )
        && isNullableCountdown(data.morningCountdownMinutes, data.morningEnabled)
        && isNullableCountdown(data.afternoonCountdownMinutes, data.afternoonEnabled)
        && isNullableCountdown(data.eveningCountdownMinutes, data.eveningEnabled)
        && isNullableCountdown(data.nightCountdownMinutes, data.nightEnabled)
        && isNullableReminder(data.morningReminderMinutes, data.morningEnabled)
        && isNullableReminder(data.afternoonReminderMinutes, data.afternoonEnabled)
        && isNullableReminder(data.eveningReminderMinutes, data.eveningEnabled)
        && isNullableReminder(data.nightReminderMinutes, data.nightEnabled)
        && isOptionalLogicalDay(data.startDate)
        && isOptionalLogicalDay(data.endDate)
        && data.supplyEnabled is bool
        && isPositiveNumber(data.unitsPerDose, 1000000)
        && isBoundedString(data.supplyUnitName, 30)
        && (
          (
            data.supplyEnabled
            && isBoundedNumber(data.supplyInitialUnits, 1000000)
            && isNullableNonNegativeNumber(data.lowSupplyThreshold, 1000000)
          )
          || (
            !data.supplyEnabled
            && data.supplyInitialUnits == null
            && data.lowSupplyThreshold == null
          )
        );
    }

    function validMedicineDocument(userId, medicineId, data) {
      return (
          data.schemaVersion == 1
          && validMedicineV1(userId, medicineId, data)
        )
        || (
          data.schemaVersion == 2
          && validMedicineV2(userId, medicineId, data)
        )
        || (
          data.schemaVersion == 3
          && validMedicineV3(userId, medicineId, data)
        );
    }

    function validCountdownStateDocument(userId, countdownStateId, data) {
      return hasExactly(
          data,
          [
            'ownerUid', 'logicalDay', 'medicineId', 'slot', 'durationMinutes',
            'startedAt', 'targetAt', 'startedTimezone', 'startedSource', 'status',
            'cancelledAt', 'completedAt', 'updatedAt', 'lastActionId', 'schemaVersion'
          ]
        )
        && data.ownerUid == userId
        && isValidLogicalDay(data.logicalDay)
        && isValidIdentifier(data.medicineId)
        && isValidSlot(data.slot)
        && countdownStateId == data.logicalDay + '_' + data.medicineId + '_' + data.slot
        && data.durationMinutes is int
        && data.durationMinutes >= 1
        && data.durationMinutes <= 1440
        && data.startedAt is timestamp
        && data.targetAt is timestamp
        && data.targetAt == data.startedAt + duration.value(data.durationMinutes, 'm')
        && isBoundedString(data.startedTimezone, 100)
        && isValidSource(data.startedSource)
        && (data.status == 'running' || data.status == 'cancelled' || data.status == 'consumed')
        && (data.cancelledAt == null || data.cancelledAt is timestamp)
        && (data.completedAt == null || data.completedAt is timestamp)
        && data.updatedAt is timestamp
        && isValidIdentifier(data.lastActionId)
        && data.schemaVersion == 1;
    }

    function validCountdownEventDocument(userId, eventId, data) {
      return hasExactly(
          data,
          [
            'eventId', 'ownerUid', 'action', 'logicalDay', 'medicineId', 'slot',
            'durationMinutes', 'occurredAt', 'timezoneId', 'source', 'relatedStateId',
            'previousActionId', 'syncedAt', 'schemaVersion'
          ]
        )
        && isValidIdentifier(data.eventId)
        && data.eventId == eventId
        && data.ownerUid == userId
        && (
          data.action == 'start'
          || data.action == 'cancel'
          || data.action == 'restart'
          || data.action == 'clear_by_check'
        )
        && isValidLogicalDay(data.logicalDay)
        && isValidIdentifier(data.medicineId)
        && isValidSlot(data.slot)
        && data.durationMinutes is int
        && data.durationMinutes >= 1
        && data.durationMinutes <= 1440
        && data.occurredAt is timestamp
        && isBoundedString(data.timezoneId, 100)
        && isValidSource(data.source)
        && (data.action == 'start' || data.action == 'clear_by_check' || data.source == 'app')
        && data.relatedStateId == data.logicalDay + '_' + data.medicineId + '_' + data.slot
        && (data.previousActionId == null || isValidIdentifier(data.previousActionId))
        && isServerTimestamp(data.syncedAt)
        && data.schemaVersion == 1;
    }

    function countdownEventAfterMatchesState(userId, stateId, state) {
      let event = getAfter(
        /databases/$(database)/documents/users/$(userId)/countdownEvents/$(state.lastActionId)
      ).data;
      let statePath = /databases/$(database)/documents/users/$(userId)/countdownStates/$(stateId);
      let previousActionId = exists(statePath) ? get(statePath).data.lastActionId : null;
      return event.ownerUid == userId
        && event.relatedStateId == stateId
        && event.logicalDay == state.logicalDay
        && event.medicineId == state.medicineId
        && event.slot == state.slot
        && event.durationMinutes == state.durationMinutes
        && (
          (
            event.action == 'start'
            && (
              (previousActionId == null && event.previousActionId == null)
              || event.previousActionId == previousActionId
            )
          )
          || (event.action != 'start' && event.previousActionId == previousActionId)
        )
        && (
          (
            (event.action == 'start' || event.action == 'restart')
            && state.status == 'running'
            && state.cancelledAt == null
            && state.completedAt == null
            && state.startedAt == event.occurredAt
            && state.startedTimezone == event.timezoneId
            && state.startedSource == event.source
          )
          || (
            event.action == 'cancel'
            && state.status == 'cancelled'
            && state.cancelledAt == event.occurredAt
            && state.completedAt == null
          )
          || (
            event.action == 'clear_by_check'
            && state.status == 'consumed'
            && state.completedAt == event.occurredAt
            && state.cancelledAt == null
          )
        );
    }

    function countdownStateAfterMatchesEvent(userId, eventId, event) {
      let state = getAfter(
        /databases/$(database)/documents/users/$(userId)/countdownStates/$(event.relatedStateId)
      ).data;
      return state.lastActionId == eventId
        && countdownEventAfterMatchesState(userId, event.relatedStateId, state);
    }

    function validCountdownStateTransition(oldState, newState) {
      return newState.ownerUid == oldState.ownerUid
        && newState.logicalDay == oldState.logicalDay
        && newState.medicineId == oldState.medicineId
        && newState.slot == oldState.slot
        && newState.lastActionId != oldState.lastActionId
        && (
          (
            (oldState.status == 'cancelled' || oldState.status == 'consumed')
            && newState.status == 'running'
            && newState.cancelledAt == null
            && newState.completedAt == null
          )
          || (oldState.status == 'running' && newState.status == 'running')
          || (oldState.status == 'running' && newState.status == 'cancelled')
          || (oldState.status == 'running' && newState.status == 'consumed')
        );
    }

    function validDoseStateV1(userId, doseStateId, data) {
      return hasExactly(
          data,
          [
            'ownerUid', 'logicalDay', 'medicineId', 'slot', 'labelSnapshot',
            'medicineNameSnapshot', 'isTaken', 'checkedAt', 'checkedTimezone',
            'checkedSource', 'undoneAt', 'lastActionId', 'updatedAt', 'schemaVersion'
          ]
        )
        && data.ownerUid == userId
        && isValidLogicalDay(data.logicalDay)
        && isValidIdentifier(data.medicineId)
        && isLegacySlot(data.slot)
        && doseStateId == data.logicalDay + '_' + data.medicineId + '_' + data.slot
        && isBoundedString(data.labelSnapshot, 60)
        && isBoundedString(data.medicineNameSnapshot, 100)
        && data.isTaken is bool
        && data.checkedAt is timestamp
        && isBoundedString(data.checkedTimezone, 100)
        && isLegacySource(data.checkedSource)
        && (data.undoneAt == null || data.undoneAt is timestamp)
        && isValidIdentifier(data.lastActionId)
        && data.updatedAt is timestamp
        && data.schemaVersion == 1;
    }

    function validDoseStateV2(userId, doseStateId, data) {
      let taken = data.isTaken == true
        && data.checkedAt is timestamp
        && isBoundedString(data.checkedTimezone, 100)
        && isValidSource(data.checkedSource)
        && data.skippedAt == null
        && data.skipReason == null
        && data.undoneAt == null;
      let skipped = data.isTaken == false
        && data.checkedAt == null
        && data.checkedTimezone == null
        && data.checkedSource == null
        && data.skippedAt is timestamp
        && (data.skipReason == null || isOptionalString(data.skipReason, 120))
        && data.undoneAt == null;
      let pendingAfterUndo = data.isTaken == false
        && data.skippedAt == null
        && data.skipReason == null
        && data.undoneAt is timestamp
        && (
          (
            data.checkedAt is timestamp
            && isBoundedString(data.checkedTimezone, 100)
            && isValidSource(data.checkedSource)
          )
          || (
            data.checkedAt == null
            && data.checkedTimezone == null
            && data.checkedSource == null
          )
        );
      return hasExactly(
          data,
          [
            'ownerUid', 'logicalDay', 'medicineId', 'slot', 'labelSnapshot',
            'medicineNameSnapshot', 'isTaken', 'checkedAt', 'checkedTimezone',
            'checkedSource', 'skippedAt', 'skipReason', 'undoneAt', 'lastActionId',
            'updatedAt', 'schemaVersion'
          ]
        )
        && data.ownerUid == userId
        && isValidLogicalDay(data.logicalDay)
        && isValidIdentifier(data.medicineId)
        && isValidSlot(data.slot)
        && doseStateId == data.logicalDay + '_' + data.medicineId + '_' + data.slot
        && isBoundedString(data.labelSnapshot, 60)
        && isBoundedString(data.medicineNameSnapshot, 100)
        && isValidIdentifier(data.lastActionId)
        && data.updatedAt is timestamp
        && data.schemaVersion == 2
        && (taken || skipped || pendingAfterUndo);
    }

    function validDoseStateDocument(userId, doseStateId, data) {
      return (
          data.schemaVersion == 1
          && validDoseStateV1(userId, doseStateId, data)
        )
        || (
          data.schemaVersion == 2
          && validDoseStateV2(userId, doseStateId, data)
        );
    }

    function validDoseEventV1(userId, eventId, data) {
      return hasExactly(
          data,
          [
            'eventId', 'ownerUid', 'action', 'logicalDay', 'medicineId',
            'medicineNameSnapshot', 'slot', 'labelSnapshot', 'occurredAt',
            'timezoneId', 'source', 'relatedStateId', 'previousActionId',
            'syncedAt', 'schemaVersion'
          ]
        )
        && isValidIdentifier(data.eventId)
        && data.eventId == eventId
        && data.ownerUid == userId
        && (data.action == 'check' || data.action == 'undo')
        && isValidLogicalDay(data.logicalDay)
        && isValidIdentifier(data.medicineId)
        && isBoundedString(data.medicineNameSnapshot, 100)
        && isLegacySlot(data.slot)
        && isBoundedString(data.labelSnapshot, 60)
        && data.occurredAt is timestamp
        && isBoundedString(data.timezoneId, 100)
        && isLegacySource(data.source)
        && (data.action == 'check' || data.source == 'app')
        && data.relatedStateId == data.logicalDay + '_' + data.medicineId + '_' + data.slot
        && (
          (data.action == 'check' && data.previousActionId == null)
          || (data.action == 'undo' && isValidIdentifier(data.previousActionId))
        )
        && isServerTimestamp(data.syncedAt)
        && data.schemaVersion == 1;
    }

    function validDoseEventV2(userId, eventId, data) {
      return hasExactly(
          data,
          [
            'eventId', 'ownerUid', 'action', 'logicalDay', 'medicineId',
            'medicineNameSnapshot', 'slot', 'labelSnapshot', 'occurredAt',
            'timezoneId', 'source', 'relatedStateId', 'previousActionId',
            'skipReason', 'syncedAt', 'schemaVersion'
          ]
        )
        && isValidIdentifier(data.eventId)
        && data.eventId == eventId
        && data.ownerUid == userId
        && (data.action == 'check' || data.action == 'skip' || data.action == 'undo')
        && isValidLogicalDay(data.logicalDay)
        && isValidIdentifier(data.medicineId)
        && isBoundedString(data.medicineNameSnapshot, 100)
        && isValidSlot(data.slot)
        && isBoundedString(data.labelSnapshot, 60)
        && data.occurredAt is timestamp
        && isBoundedString(data.timezoneId, 100)
        && isValidSource(data.source)
        && data.relatedStateId == data.logicalDay + '_' + data.medicineId + '_' + data.slot
        && (
          (
            data.action == 'check'
            && data.previousActionId == null
            && data.skipReason == null
          )
          || (
            data.action == 'skip'
            && data.source == 'app'
            && data.previousActionId == null
            && (data.skipReason == null || isOptionalString(data.skipReason, 120))
          )
          || (
            data.action == 'undo'
            && data.source == 'app'
            && isValidIdentifier(data.previousActionId)
            && data.skipReason == null
          )
        )
        && isServerTimestamp(data.syncedAt)
        && data.schemaVersion == 2;
    }

    function validDoseEventDocument(userId, eventId, data) {
      return (
          data.schemaVersion == 1
          && validDoseEventV1(userId, eventId, data)
        )
        || (
          data.schemaVersion == 2
          && validDoseEventV2(userId, eventId, data)
        );
    }

    function eventAfterMatchesState(userId, doseStateId, state) {
      let event = getAfter(
        /databases/$(database)/documents/users/$(userId)/doseEvents/$(state.lastActionId)
      ).data;
      let statePath = /databases/$(database)/documents/users/$(userId)/doseStates/$(doseStateId);
      let previousActionId = exists(statePath) ? get(statePath).data.lastActionId : null;
      let common = event.ownerUid == userId
        && event.eventId == state.lastActionId
        && event.logicalDay == state.logicalDay
        && event.medicineId == state.medicineId
        && event.medicineNameSnapshot == state.medicineNameSnapshot
        && event.slot == state.slot
        && event.labelSnapshot == state.labelSnapshot
        && event.relatedStateId == doseStateId;
      let v1 = state.schemaVersion == 1
        && event.schemaVersion == 1
        && (
          (
            event.action == 'check'
            && state.isTaken == true
            && state.undoneAt == null
            && event.previousActionId == null
            && event.occurredAt == state.checkedAt
            && event.timezoneId == state.checkedTimezone
            && event.source == state.checkedSource
          )
          || (
            event.action == 'undo'
            && state.isTaken == false
            && state.undoneAt == event.occurredAt
            && event.previousActionId == previousActionId
          )
        );
      let v2 = state.schemaVersion == 2
        && event.schemaVersion == 2
        && (
          (
            event.action == 'check'
            && state.isTaken == true
            && state.skippedAt == null
            && state.undoneAt == null
            && event.previousActionId == null
            && event.occurredAt == state.checkedAt
            && event.timezoneId == state.checkedTimezone
            && event.source == state.checkedSource
          )
          || (
            event.action == 'skip'
            && state.isTaken == false
            && state.skippedAt == event.occurredAt
            && state.undoneAt == null
            && event.previousActionId == null
            && event.skipReason == state.skipReason
          )
          || (
            event.action == 'undo'
            && state.isTaken == false
            && state.skippedAt == null
            && state.undoneAt == event.occurredAt
            && event.previousActionId == previousActionId
          )
        );
      return common && (v1 || v2);
    }

    function stateAfterMatchesEvent(userId, eventId, event) {
      let state = getAfter(
        /databases/$(database)/documents/users/$(userId)/doseStates/$(event.relatedStateId)
      ).data;
      return state.lastActionId == eventId
        && state.logicalDay == event.logicalDay
        && state.medicineId == event.medicineId
        && state.slot == event.slot
        && eventAfterMatchesState(userId, event.relatedStateId, state);
    }

    function isTakenDoseState(state) {
      return state.isTaken == true && state.undoneAt == null;
    }

    function isSkippedDoseState(state) {
      return state.schemaVersion == 2
        && state.isTaken == false
        && state.skippedAt is timestamp
        && state.undoneAt == null;
    }

    function isPendingDoseState(state) {
      return state.isTaken == false
        && state.undoneAt is timestamp
        && (
          state.schemaVersion == 1
          || (
            state.schemaVersion == 2
            && state.skippedAt == null
            && state.skipReason == null
          )
        );
    }

    function validDoseStateTransition(userId, oldState, newState) {
      let event = getAfter(
        /databases/$(database)/documents/users/$(userId)/doseEvents/$(newState.lastActionId)
      ).data;
      let identityPreserved = newState.ownerUid == oldState.ownerUid
        && newState.logicalDay == oldState.logicalDay
        && newState.medicineId == oldState.medicineId
        && newState.slot == oldState.slot
        && newState.lastActionId != oldState.lastActionId;
      let undoResolved = event.action == 'undo'
        && (isTakenDoseState(oldState) || isSkippedDoseState(oldState))
        && isPendingDoseState(newState);
      let checkPending = event.action == 'check'
        && isPendingDoseState(oldState)
        && isTakenDoseState(newState);
      let skipPending = event.action == 'skip'
        && isPendingDoseState(oldState)
        && isSkippedDoseState(newState);
      return identityPreserved && (undoResolved || checkPending || skipPending);
    }

    match /users/{userId} {
      allow get: if ownsPath(userId);
      allow create: if ownsPath(userId)
        && validUserDocument(userId, request.resource.data)
        && isServerTimestamp(request.resource.data.createdAt)
        && isServerTimestamp(request.resource.data.updatedAt);
      allow update: if ownsPath(userId)
        && validUserDocument(userId, request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && isServerTimestamp(request.resource.data.updatedAt);
      allow delete: if ownsPath(userId);

      match /settings/{settingsId} {
        allow get, list: if ownsPath(userId);
        allow create: if ownsPath(userId)
          && settingsId == 'preferences'
          && validSettingsDocument(userId, request.resource.data)
          && isServerTimestamp(request.resource.data.updatedAt);
        allow update: if ownsPath(userId)
          && settingsId == 'preferences'
          && validSettingsDocument(userId, request.resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && isServerTimestamp(request.resource.data.updatedAt);
        allow delete: if ownsPath(userId);
      }

      match /medicines/{medicineId} {
        allow get, list: if ownsPath(userId);
        allow create: if ownsPath(userId)
          && validMedicineDocument(userId, medicineId, request.resource.data)
          && isServerTimestamp(request.resource.data.createdAt)
          && isServerTimestamp(request.resource.data.updatedAt);
        allow update: if ownsPath(userId)
          && validMedicineDocument(userId, medicineId, request.resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && isServerTimestamp(request.resource.data.updatedAt);
        allow delete: if ownsPath(userId);
      }

      match /doseStates/{doseStateId} {
        allow get, list: if ownsPath(userId);
        allow create: if ownsPath(userId)
          && validDoseStateDocument(userId, doseStateId, request.resource.data)
          && request.resource.data.undoneAt == null
          && isServerTimestamp(request.resource.data.updatedAt)
          && eventAfterMatchesState(userId, doseStateId, request.resource.data);
        allow update: if ownsPath(userId)
          && validDoseStateDocument(userId, doseStateId, request.resource.data)
          && validDoseStateTransition(userId, resource.data, request.resource.data)
          && isServerTimestamp(request.resource.data.updatedAt)
          && eventAfterMatchesState(userId, doseStateId, request.resource.data);
        allow delete: if ownsPath(userId);
      }

      match /doseEvents/{eventId} {
        allow get, list: if ownsPath(userId);
        allow create: if ownsPath(userId)
          && validDoseEventDocument(userId, eventId, request.resource.data)
          && stateAfterMatchesEvent(userId, eventId, request.resource.data);
        allow update: if false;
        allow delete: if ownsPath(userId);
      }

      match /countdownStates/{countdownStateId} {
        allow get, list: if ownsPath(userId);
        allow create: if ownsPath(userId)
          && validCountdownStateDocument(userId, countdownStateId, request.resource.data)
          && request.resource.data.status == 'running'
          && request.resource.data.cancelledAt == null
          && request.resource.data.completedAt == null
          && isServerTimestamp(request.resource.data.updatedAt)
          && countdownEventAfterMatchesState(userId, countdownStateId, request.resource.data);
        allow update: if ownsPath(userId)
          && validCountdownStateDocument(userId, countdownStateId, request.resource.data)
          && validCountdownStateTransition(resource.data, request.resource.data)
          && isServerTimestamp(request.resource.data.updatedAt)
          && countdownEventAfterMatchesState(userId, countdownStateId, request.resource.data);
        allow delete: if ownsPath(userId);
      }

      match /countdownEvents/{eventId} {
        allow get, list: if ownsPath(userId);
        allow create: if ownsPath(userId)
          && validCountdownEventDocument(userId, eventId, request.resource.data)
          && countdownStateAfterMatchesEvent(userId, eventId, request.resource.data);
        allow update: if false;
        allow delete: if ownsPath(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
