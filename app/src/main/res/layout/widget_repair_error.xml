<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_repair_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_repair_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_repair_default_title"
        android:textColor="@color/widget_repair_foreground"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_repair_message"
        android:textColor="@color/widget_repair_supporting"
        android:textSize="14sp" />

    <Button
        android:id="@+id/widget_repair_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_repair_button" />

</LinearLayout>
