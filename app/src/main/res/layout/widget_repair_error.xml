<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F7"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_repair_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Meds Widget"
        android:textColor="#111114"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="The launcher could not refresh this widget. Your medicine data is still in the app."
        android:textColor="#3A3A3C"
        android:textSize="14sp" />

    <Button
        android:id="@+id/widget_repair_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Repair widget" />

</LinearLayout>
